bool isMathQuestion(String s) {
  return s.indexOf("+") >= 0 || s.indexOf("-") >= 0 || 
         s.indexOf("*") >= 0 || s.indexOf("/") >= 0 ||
         s.indexOf("plus") >= 0 || s.indexOf("minus") >= 0 || 
         s.indexOf("mal") >= 0 || s.indexOf("geteilt") >= 0;
}

String calculate(String s) {
  int num1 = 0, num2 = 0;
  char op = ' ';
  
  int i = 0;
  while (i < s.length() && !isDigit(s[i])) i++;
  while (i < s.length() && isDigit(s[i])) {
    num1 = num1 * 10 + (s[i] - '0');
    i++;
  }
  
  while (i < s.length()) {
    if (s[i] == '+') { op = '+'; break; }
    if (s[i] == '-') { op = '-'; break; }
    if (s[i] == '*') { op = '*'; break; }
    if (s[i] == '/') { op = '/'; break; }
    if (s.substring(i).startsWith("plus")) { op = '+'; break; }
    if (s.substring(i).startsWith("minus")) { op = '-'; break; }
    if (s.substring(i).startsWith("mal")) { op = '*'; break; }
    if (s.substring(i).startsWith("geteilt")) { op = '/'; break; }
    i++;
  }
  
  if (op == ' ') return "Keine Rechnung erkannt";
  
  while (i < s.length() && !isDigit(s[i])) i++;
  while (i < s.length() && isDigit(s[i])) {
    num2 = num2 * 10 + (s[i] - '0');
    i++;
  }
  
  long result = 0;
  switch(op) {
    case '+': result = num1 + num2; break;
    case '-': result = num1 - num2; break;
    case '*': result = num1 * num2; break;
    case '/': 
      if (num2 == 0) return "Division durch Null!";
      result = num1 / num2; 
      break;
  }
  
  return String(num1) + " " + op + " " + String(num2) + " = " + String(result);
}

