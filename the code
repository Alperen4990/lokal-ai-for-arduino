// EEPROM-Konfiguration
#define EEPROM_SIZE 512
#define MAGIC_ADDR 0
#define MAGIC_VALUE 42
#define JA_NEIN_START 10
#define JA_NEIN_MAX 15
#define W_FRAGE_START 350
#define W_FRAGE_MAX 15
#define ENTRY_SIZE 34

// RAM-Cache für gelernte Daten
String jaNeinKeys[JA_NEIN_MAX];
String jaNeinValues[JA_NEIN_MAX];
int jaNeinCount = 0;

String wFrageSubjects[W_FRAGE_MAX];
String wFrageValues[W_FRAGE_MAX];
int wFrageCount = 0;

void setup() {
  Serial.begin(9600);
  delay(1000);
  
  Serial.println("=== Mini-KI Bot (3 Datenbanken) ===");
  Serial.println("Manuelle DB: " + String(MANUAL_DB));
  
  // EEPROM initialisieren/laden
  if (EEPROM.read(MAGIC_ADDR) != MAGIC_VALUE) {
    Serial.println("Erster Start - initialisiere EEPROM...");
    clearEEPROM();
    EEPROM.write(MAGIC_ADDR, MAGIC_VALUE);
    Serial.println("EEPROM bereit!");
  } else {
    Serial.println("Lade gelerntes Wissen aus EEPROM...");
    loadFromEEPROM();
    Serial.print("Geladen: ");
    Serial.print(jaNeinCount);
    Serial.print(" Ja/Nein, ");
    Serial.print(wFrageCount);
    Serial.println(" W-Fragen");
  }
  
  Serial.println("Bot bereit! (Reset mit 'reset')");
  Serial.println("Tippe 'db' zum Anzeigen\n");
}

void loop() {
  if (Serial.available() > 0) {
    inputText = Serial.readStringUntil('\n');
    inputText.trim();
    
    String originalInput = inputText;
    inputText.toLowerCase();

    Serial.print("Du: ");
    Serial.println(inputText);

    // LERN-MODUS
    if (waitingForAnswer) {
      handleLearning(inputText);
      return;
    }

    // === 1. RESET BEFEHL ===
    if (inputText == "reset" || inputText == "resete dich") {
      clearEEPROM();
      EEPROM.write(MAGIC_ADDR, MAGIC_VALUE);
      jaNeinCount = 0;
      wFrageCount = 0;
      lastAddedIndex = -1;
      outputText = "Alles geloescht! Nur manuelle DB bleibt.";
      Serial.print("Bot: ");
      Serial.println(outputText);
      return;
    }

    // === 2. FEHLER/UNDO BEFEHL ===
    if (inputText == "falsch" || inputText == "fehler" || inputText == "nein" || inputText == "nö" || inputText == "noe") {
      if (undoLastEntry()) {
        outputText = "Entschuldigung! Ich habe den letzten Eintrag geloescht.";
      } else {
        outputText = "Entschuldigung, ich kann viele Fehler machen!";
      }
      Serial.print("Bot: ");
      Serial.println(outputText);
      return;
    }

    // === 3. MANUELLE DATENBANK PRÜFEN (zuerst!) ===
    String manualAnswer = checkManualDB(inputText);
    if (manualAnswer != "") {
      outputText = manualAnswer;
      Serial.print("Bot: ");
      Serial.println(outputText);
      return;
    }

    // === 4. GELERNTE DATENBANKEN PRÜFEN ===
    String subject = extractSubject(originalInput);
    String adjective = extractAdjective(inputText);
    String key = subject + "_" + adjective;
    
    if (existsInJaNeinDB(key)) {
      outputText = getFromJaNeinDB(key);
    }
    else if (checkWFrageDB(inputText, originalInput)) {
      return;
    }
    
    // === 5. RECHNEN ===
    else if (containsNumber(inputText) && isMathQuestion(inputText)) {
      outputText = calculate(inputText);
    }

    // === 6. JA/NEIN FRAGE (explizite Verben) ===
    else if (isJaNeinQuestion(inputText)) {
      if (subject == "" || adjective == "") {
        outputText = "Ich verstehe nicht. (Format: Ist [Subjekt] [Adjektiv]?)";
      } else {
        outputText = "Ich weiss nicht. Ist " + subject + " " + adjective + "? (ja/nein)";
        lastQuestion = key;
        lastSubject = subject;
        lastAdjective = adjective;
        waitingForAnswer = true;
        learnMode = 1;
      }
    }

    // === 7. W-FRAGE ===
    else if (isWQuestion(inputText)) {
      String wSubject = extractImportantWord(originalInput);
      
      if (existsInWFrageDB(wSubject)) {
        outputText = getFromWFrageDB(wSubject);
      } else {
        outputText = "Ich weiss nicht. Wer oder was ist " + wSubject + "?";
        lastSubject = wSubject;
        waitingForAnswer = true;
        learnMode = 2;
      }
    }

    // === 8. VERB AM ANFANG ===
    else if (checkVerbStart(inputText, originalInput)) {
      // Die Funktion macht jetzt alles selbst (outputText setzen oder lernen starten)
      Serial.print("Bot: ");
      Serial.println(outputText);
      return;
    }

    // === 9. FRAGEZEICHEN ===
    else if (inputText.endsWith("?")) {
      outputText = "Fragezeichen erkannt";
    }

    // === 10. SONSTIGES ===
    else if (inputText == "hi" || inputText == "hallo") {
      outputText = "Hallo!";
    }
    else if (inputText == "danke") {
      outputText = "Bitte!";
    }
    else if (inputText == "tschau") {
      outputText = "Tschau!";
    }
    else if (inputText == "db") {
      showDatabase();
      return;
    }
    else if (isSingleWord(inputText)) {
      outputText = inputText;
    }
    
    // === 11. FALLBACK: Verb-Endung ===
    else if (hasVerbEnding(inputText)) {
      String verb = extractFirstWord(inputText);
      String subj = extractSecondWord(inputText);
      
      if (subj == "") {
        outputText = "Ich verstehe nicht. (Format: [Verb] [Subjekt])";
      } else {
        key = verb + "_" + subj;
        
        if (existsInJaNeinDB(key)) {
          outputText = getFromJaNeinDB(key);
        } else {
          outputText = "Ich weiss nicht. Koennen " + subj + " " + verb + "? (ja/nein)";
          lastQuestion = key;
          lastSubject = subj;
          lastAdjective = verb;
          waitingForAnswer = true;
          learnMode = 1;
        }
      }
    }
    
    // === 12. DEFAULT ===
    else {
      outputText = "Sorry, kein Kontext gefunden!";
    }

    Serial.print("Bot: ");
    Serial.println(outputText);
  }
}

// === MANUELLE DATENBANK ===

String checkManualDB(String input) {
  // Parse MANUAL_DB: "fragewort|antwort,fragewort|antwort,..."
  String db = String(MANUAL_DB);
  db.toLowerCase();
  input.toLowerCase();
  
  int start = 0;
  while (start < db.length()) {
    // Finde nächsten Eintrag (bis Komma)
    int comma = db.indexOf(',', start);
    if (comma < 0) comma = db.length();
    
    String entry = db.substring(start, comma);
    
    // Teile in fragewort und antwort
    int pipe = entry.indexOf('|');
    if (pipe > 0) {
      String trigger = entry.substring(0, pipe);
      String answer = entry.substring(pipe + 1);
      
      // Prüfe ob trigger im input vorkommt
      if (input.indexOf(trigger) >= 0) {
        return answer;
      }
    }
    
    start = comma + 1;
  }
  
  return ""; // Nichts gefunden
}

// === LERN-FUNKTIONEN ===

void handleLearning(String answer) {
  waitingForAnswer = false;
  bool success = false;
  
  if (learnMode == 1) {
    String cleanAnswer = "";
    if (answer.indexOf("ja") >= 0) cleanAnswer = "ja";
    else if (answer.indexOf("nein") >= 0) cleanAnswer = "nein";
    
    if (cleanAnswer != "") {
      success = saveToJaNeinDB(lastQuestion, cleanAnswer);
      if (success) {
        outputText = "Gelernt! " + lastSubject + " " + lastAdjective + " -> " + cleanAnswer;
      } else {
        outputText = "Fehler: DB voll!";
      }
    } else {
      outputText = "Bitte mit ja oder nein antworten.";
      waitingForAnswer = true;
      return;
    }
  }
  else if (learnMode == 2) {
    success = saveToWFrageDB(lastSubject, answer);
    if (success) {
      outputText = "Ok gespeichert, " + answer;
    } else {
      outputText = "Fehler: DB voll!";
    }
  }
  
  learnMode = 0;
  Serial.print("Bot: ");
  Serial.println(outputText);
}

bool undoLastEntry() {
  if (lastAddedType == 1 && lastAddedIndex >= 0 && lastAddedIndex < jaNeinCount) {
    Serial.print("[UNDO] Lösche Ja/Nein Eintrag ");
    Serial.println(lastAddedIndex);
    
    int addr = JA_NEIN_START + (lastAddedIndex * ENTRY_SIZE);
    EEPROM.write(addr, 0xFF);
    
    for (int i = lastAddedIndex; i < jaNeinCount - 1; i++) {
      jaNeinKeys[i] = jaNeinKeys[i + 1];
      jaNeinValues[i] = jaNeinValues[i + 1];
    }
    jaNeinCount--;
    
    lastAddedIndex = -1;
    lastAddedType = 0;
    return true;
  }
  else if (lastAddedType == 2 && lastAddedIndex >= 0 && lastAddedIndex < wFrageCount) {
    Serial.print("[UNDO] Lösche W-Frage Eintrag ");
    Serial.println(lastAddedIndex);
    
    int addr = W_FRAGE_START + (lastAddedIndex * ENTRY_SIZE);
    EEPROM.write(addr, 0xFF);
    
    for (int i = lastAddedIndex; i < wFrageCount - 1; i++) {
      wFrageSubjects[i] = wFrageSubjects[i + 1];
      wFrageValues[i] = wFrageValues[i + 1];
    }
    wFrageCount--;
    
    lastAddedIndex = -1;
    lastAddedType = 0;
    return true;
  }
  
  return false;
}

// === EEPROM FUNKTIONEN ===

void clearEEPROM() {
  for (int i = 0; i < EEPROM_SIZE; i++) {
    EEPROM.write(i, 0xFF);
  }
}

void loadFromEEPROM() {
  jaNeinCount = 0;
  for (int i = 0; i < JA_NEIN_MAX; i++) {
    int addr = JA_NEIN_START + (i * ENTRY_SIZE);
    if (EEPROM.read(addr) == 1) {
      jaNeinKeys[i] = readEEPROMString(addr + 1, 16);
      jaNeinValues[i] = readEEPROMString(addr + 17, 16);
      jaNeinCount++;
    }
  }
  
  wFrageCount = 0;
  for (int i = 0; i < W_FRAGE_MAX; i++) {
    int addr = W_FRAGE_START + (i * ENTRY_SIZE);
    if (EEPROM.read(addr) == 1) {
      wFrageSubjects[i] = readEEPROMString(addr + 1, 16);
      wFrageValues[i] = readEEPROMString(addr + 17, 16);
      wFrageCount++;
    }
  }
}

void saveToEEPROM(int type, int index, String key, String value) {
  int addr;
  if (type == 1) addr = JA_NEIN_START + (index * ENTRY_SIZE);
  else addr = W_FRAGE_START + (index * ENTRY_SIZE);
  
  EEPROM.write(addr, 1);
  writeEEPROMString(addr + 1, 16, key);
  writeEEPROMString(addr + 17, 16, value);
}

String readEEPROMString(int addr, int maxLen) {
  String result = "";
  for (int i = 0; i < maxLen; i++) {
    char c = EEPROM.read(addr + i);
    if (c == 0 || c == 0xFF) break;
    result += c;
  }
  return result;
}

void writeEEPROMString(int addr, int maxLen, String str) {
  int len = str.length();
  if (len > maxLen - 1) len = maxLen - 1;
  
  for (int i = 0; i < len; i++) {
    EEPROM.write(addr + i, str[i]);
  }
  EEPROM.write(addr + len, 0);
  for (int i = len + 1; i < maxLen; i++) {
    EEPROM.write(addr + i, 0);
  }
}

// === TEXT-HILFSFUNKTIONEN ===

String extractFirstWord(String sentence) {
  int spaceIdx = sentence.indexOf(' ');
  if (spaceIdx < 0) return sentence;
  String result = sentence.substring(0, spaceIdx);
  result.toLowerCase();
  return result;
}

String extractSecondWord(String sentence) {
  int firstSpace = sentence.indexOf(' ');
  if (firstSpace < 0) return "";
  
  int secondSpace = sentence.indexOf(' ', firstSpace + 1);
  String result;
  if (secondSpace < 0) {
    result = sentence.substring(firstSpace + 1);
  } else {
    result = sentence.substring(firstSpace + 1, secondSpace);
  }
  result.toLowerCase();
  return result;
}

bool hasVerbEnding(String s) {
  int len = 0;
  while (len < s.length() && s[len] != ' ') len++;
  if (len < 2) return false;
  
  String firstWord = s.substring(0, len);
  
  if (firstWord.endsWith("e")) return true;
  if (firstWord.endsWith("st")) return true;
  if (firstWord.endsWith("t")) return true;
  if (firstWord.endsWith("en")) return true;
  if (firstWord.endsWith("te")) return true;
  if (firstWord.endsWith("test")) return true;
  if (firstWord.endsWith("tet")) return true;
  if (firstWord.endsWith("ten")) return true;
  
  return false;
}

String extractSubject(String sentence) {
  String words[10];
  int wordCount = 0;
  String current = "";
  
  for (int i = 0; i <= sentence.length(); i++) {
    if (i == sentence.length() || sentence[i] == ' ') {
      if (current.length() > 0) {
        words[wordCount++] = current;
        current = "";
      }
    } else {
      current += sentence[i];
    }
  }
  
  bool foundVerb = false;
  for (int i = 0; i < wordCount; i++) {
    String lower = words[i];
    lower.toLowerCase();
    
    if (!foundVerb) {
      if (isVerb(lower)) {
        foundVerb = true;
      }
      continue;
    }
    
    if (words[i].length() > 0) {
      char firstChar = words[i][0];
      if (firstChar >= 'A' && firstChar <= 'Z') {
        String result = words[i];
        result.toLowerCase();
        return result;
      }
    }
  }
  
  return "";
}

String extractAdjective(String sentence) {
  String words[10];
  int wordCount = 0;
  String current = "";
  
  for (int i = 0; i <= sentence.length(); i++) {
    if (i == sentence.length() || sentence[i] == ' ') {
      if (current.length() > 0) {
        words[wordCount++] = current;
        current = "";
      }
    } else {
      current += sentence[i];
    }
  }
  
  if (wordCount >= 2) {
    String last = words[wordCount - 1];
    if (last.endsWith("?")) {
      last = last.substring(0, last.length() - 1);
    }
    last.toLowerCase();
    return last;
  }
  
  return "";
}

String extractImportantWord(String sentence) {
  String pronomen[] = {"ich", "du", "er", "sie", "es", "wir", "ihr"};
  String ignoreWords[] = {"wer", "was", "wo", "wann", "warum", "wie", "womit", 
                          "wovon", "wobei", "woran", "worum", "wofuer", "wohin"};
  
  String words[10];
  int wordCount = 0;
  String current = "";
  
  for (int i = 0; i <= sentence.length(); i++) {
    if (i == sentence.length() || sentence[i] == ' ') {
      if (current.length() > 0) {
        words[wordCount++] = current;
        current = "";
      }
    } else {
      current += sentence[i];
    }
  }
  
  for (int i = 0; i < wordCount; i++) {
    String lowerWord = words[i];
    lowerWord.toLowerCase();
    
    for (int p = 0; p < 7; p++) {
      if (lowerWord == pronomen[p]) {
        return lowerWord;
      }
    }
  }
  
  for (int i = 0; i < wordCount; i++) {
    String lowerCheck = words[i];
    lowerCheck.toLowerCase();
    
    bool ignore = false;
    for (int ig = 0; ig < 13; ig++) {
      if (lowerCheck == ignoreWords[ig]) {
        ignore = true;
        break;
      }
    }
    if (ignore) continue;
    
    if (words[i].length() > 0) {
      char firstChar = words[i][0];
      if (firstChar >= 'A' && firstChar <= 'Z') {
        return words[i];
      }
    }
  }
  
  if (wordCount > 0) {
    for (int i = wordCount - 1; i >= 0; i--) {
      String lowerCheck = words[i];
      lowerCheck.toLowerCase();
      
      bool ignore = false;
      for (int ig = 0; ig < 13; ig++) {
        if (lowerCheck == ignoreWords[ig]) {
          ignore = true;
          break;
        }
      }
      if (!ignore) {
        lowerCheck.toLowerCase();
        return lowerCheck;
      }
    }
  }
  
  return "das";
}

bool isVerb(String word) {
  String verbs[] = {"ist", "sind", "war", "waren", "hat", "haben", "hast", "habt",
                    "kann", "können", "kannst", "macht", "machen", "tut", "tun",
                    "geht", "gehen", "kommt", "kommen", "sieht", "sehen", "bist",
                    "fliegt", "fliegen", "schwimmt", "schwimmen"};
  for (int i = 0; i < 26; i++) {
    if (word == verbs[i]) return true;
  }
  return false;
}

bool checkVerbStart(String s, String originalInput) {
  String words[10];
  int wordCount = 0;
  int start = 0;
  
  for (int i = 0; i <= s.length(); i++) {
    if (i == s.length() || s[i] == ' ') {
      if (i > start) {
        words[wordCount++] = s.substring(start, i);
      }
      start = i + 1;
    }
  }
  
  if (wordCount == 0) return false;
  
  String firstWord = words[0];
  String lowerFirst = firstWord;
  lowerFirst.toLowerCase();
  
  // Prüfe ob es ein Verb ist (endungen oder in der verb-liste)
  bool isVerbStart = false;
  if (lowerFirst.endsWith("e") || lowerFirst.endsWith("st") || 
      lowerFirst.endsWith("t") || lowerFirst.endsWith("en") ||
      lowerFirst.endsWith("te") || lowerFirst.endsWith("test") ||
      lowerFirst.endsWith("tet") || lowerFirst.endsWith("ten") ||
      isVerb(lowerFirst)) {
    isVerbStart = true;
  }
  
  if (!isVerbStart) return false;
  
  // Extrahiere Subjekt (zweites Wort oder danach)
  String subject = "";
  for (int i = 1; i < wordCount; i++) {
    String word = words[i];
    // Überspringe Artikel
    String lowerWord = word;
    lowerWord.toLowerCase();
    if (lowerWord == "der" || lowerWord == "die" || lowerWord == "das" ||
        lowerWord == "ein" || lowerWord == "eine" || lowerWord == "einer" ||
        lowerWord == "den" || lowerWord == "dem") {
      continue;
    }
    subject = word;
    break;
  }
  
  if (subject == "") {
    outputText = "Ich verstehe nicht. (Format: [Verb] [Subjekt])";
    return true; // true weil wir es als Verb erkannt haben, auch wenn unvollständig
  }
  
  // Entferne Fragezeichen vom Verb
  if (firstWord.endsWith("?")) {
    firstWord = firstWord.substring(0, firstWord.length() - 1);
  }
  subject.toLowerCase();
  
  String key = firstWord + "_" + subject;
  
  // Prüfe ob wir es schon kennen
  if (existsInJaNeinDB(key)) {
    outputText = getFromJaNeinDB(key);
  } else {
    // Frage nach
    outputText = "Ich weiss nicht. Koennen " + subject + " " + firstWord + "? (ja/nein)";
    lastQuestion = key;
    lastSubject = subject;
    lastAdjective = firstWord; // Hier speichern wir das Verb
    waitingForAnswer = true;
    learnMode = 1;
  }
  
  return true;
}

